DB_ROOT_PASSWORD=rootpass
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_pass

# Pembayaran Xendit (Test Mode, saran dosen). Isi dengan secret key Xendit Test Mode.
# Bila kosong, pembayaran DITOLAK kecuali DEMO_MODE=true ditulis eksplisit di bawah.
XENDIT_SECRET_KEY=
# Token callback webhook Xendit: HARUS sama dengan token di dashboard Xendit
# (Settings -> Webhooks -> Callback Token). Kode webhook membaca nama variabel ini.
XENDIT_WEBHOOK_TOKEN=
# DEMO_MODE=true hanya untuk latihan lokal: order langsung ditandai dibayar tanpa
# pembayaran. JANGAN pernah aktif di server bersama / demo ke dosen.
DEMO_MODE=false

# Email SMTP untuk kirim kode OTP lupa kata sandi (dipakai src/lib/mail.php).
# Contoh Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=tls,
# SMTP_USER=alamat Gmail, SMTP_PASS=App Password Gmail (bukan kata sandi biasa;
# buat di Google Account -> Keamanan -> Verifikasi 2 langkah -> App Passwords).
# SMTP_FROM = alamat pengirim (biasanya sama dengan SMTP_USER).
# Tanpa keempat nilai ini, kirim OTP gagal dengan pesan yang jujur
# (lupa_kirim.php tidak pura-pura terkirim).
# JANGAN pernah menulis kata sandi asli di file ini — file ini masuk repo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=tls
