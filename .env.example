DB_ROOT_PASSWORD=rootpass
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_pass

# Pembayaran Xendit (Test Mode, saran dosen). Isi dengan secret key Xendit Test Mode.
# Bila kosong, pembayaran DITOLAK kecuali DEMO_MODE=true ditulis eksplisit di bawah.
XENDIT_SECRET_KEY=
# Token callback webhook Xendit: HARUS sama dengan token di dashboard Xendit
# (Settings -> Webhooks -> Callback Token). Kode webhook membaca nama variabel ini.
XENDIT_WEBHOOK_TOKEN=
# DEMO_MODE=true hanya untuk latihan lokal: order langsung ditandai dibayar tanpa
# pembayaran. JANGAN pernah aktif di server bersama / demo ke dosen.
DEMO_MODE=false

# Pengiriman email OTP (dipakai src/lib/otp.php).
# SMTP_USER diisi alamat Gmail pengirim, SMTP_PASS diisi kata sandi aplikasi
# Gmail (16 karakter, dibuat di Keamanan Akun Google -> Verifikasi 2 langkah
# -> Kata sandi aplikasi), BUKAN kata sandi login Gmail.
# SMTP_FROM default = SMTP_USER bila dikosongkan.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_SECURE: 'tls' (port 587, default), 'ssl' (port 465), atau 'none'
# (tanpa enkripsi, HANYA untuk catcher SMTP lokal saat pengujian di VM).
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Staplr
# MODE TES OTP: true = kode OTP dikembalikan API dan ditampilkan di layar
# (dipakai saat menguji tanpa email sungguhan, mis. akun demo yang
# alamatnya bukan inbox asli). Default false = kode hanya lewat email.
# JANGAN pernah true di server bersama / demo ke dosen.
OTP_TEST_MODE=false
